{
  "expo": {
    "name": "Vita",
    "slug": "vita",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/ic_launcher.svg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/ic_launcher.svg",
      "resizeMode": "contain",
      "backgroundColor": "#0B132B",
      "imageWidth": 200,
      "imageHeight": 200
    },
    "android": {
      "package": "com.vita.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ic_launcher_foreground.svg",
        "backgroundImage": "./assets/images/ic_launcher_background.svg",
        "backgroundColor": "#F4EFE7"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vita.app"
    },
    "plugins": [
      "expo-speech",
      "react-native-mmkv",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "vita-app"
      }
    }
  }
}
