{
  "expo": {
    "name": "Vita",
    "slug": "vita",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/ic_launcher.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/ic_launcher.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B132B",
      "imageWidth": 200,
      "imageHeight": 200
    },
    "android": {
      "package": "com.vita.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ic_launcher_foreground.png",
        "backgroundImage": "./assets/images/ic_launcher_background.png",
        "backgroundColor": "#F4EFE7"
      },
      "minSdkVersion": 24
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vita.app"
    },
    "plugins": [
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "29d2ebda-4166-404c-b71c-c95aabe82dfd"
      }
    },
    "owner": "axelumatica"
  }
}
